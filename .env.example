# ルーター接続情報（このファイルをコピーして .env を作る / 本番は ~/.config/home-network-api-server/router.env）
# RTX810 側で `sshd service on` と `login user <名前> <パスワード>` を設定しておくこと（README 参照）
ROUTER_HOST=192.168.100.1
ROUTER_SSH_PORT=22
ROUTER_USERNAME=
ROUTER_PASSWORD=
ROUTER_TIMEOUT=10

# 収集結果 JSON の保存先。未設定なら ~/.local/state/home-network-api-server/clients.json
CLIENTS_JSON_PATH=./clients.json

# API サーバーの待ち受け設定
API_HOST=0.0.0.0
API_PORT=8000
