# ルーター接続情報（このファイルをコピーして .env を作る / 本番は /etc/home-network-api-server/router.env）
ROUTER_HOST=http://192.168.0.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=

# 収集結果 JSON の保存先。未設定なら /var/lib/home-network-api-server/clients.json
CLIENTS_JSON_PATH=./clients.json

# API サーバーの待ち受け設定
API_HOST=0.0.0.0
API_PORT=8000
