# /etc/home-network-api-server/router.env として配置する
#   sudo install -o root -g hnapi -m 0640 router.env.example /etc/home-network-api-server/router.env
#
# collector サービスだけが読む。API サーバーはこのファイルを必要としない。
ROUTER_HOST=http://192.168.0.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=ここにルーターの管理パスワード
ROUTER_TIMEOUT=10
