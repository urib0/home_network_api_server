# ~/.config/home-network-api-server/router.env として配置する
#   install -m 0600 router.env.example ~/.config/home-network-api-server/router.env
#
# collector サービスだけが読む。API サーバーはこのファイルを必要としない。
#
# RTX810 側の準備（README の「RTX810 側の設定」を参照）:
#   administrator
#   sshd host key generate
#   sshd service on
#   login user hnapi <パスワード>
#   save
ROUTER_HOST=192.168.100.1
ROUTER_SSH_PORT=22
ROUTER_USERNAME=ここに login user で作ったユーザー名
ROUTER_PASSWORD=ここにそのユーザーのパスワード
ROUTER_TIMEOUT=10

# Archer A10（任意）。接続中端末の接続種別を補うために使う。
ARCHER_HOST=http://10.10.10.5
ARCHER_USERNAME=admin
ARCHER_PASSWORD=ここにArcherの管理パスワード
ARCHER_TIMEOUT=10
