[Unit]
Description=Archer A10 のクライアント一覧を取得して JSON に保存する (ワンショット)
Documentation=https://github.com/uribo/home_network_api_server
# ネットワークが上がってから実行する
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hnapi
Group=hnapi

# ルーターの IP / ユーザー名 / パスワードはこのファイルに置く (chmod 600, root:hnapi)
EnvironmentFile=/etc/home-network-api-server/router.env

# /var/lib/home-network-api-server を systemd が作成・所有権設定する
StateDirectory=home-network-api-server
Environment=CLIENTS_JSON_PATH=/var/lib/home-network-api-server/clients.json

WorkingDirectory=/opt/home-network-api-server
ExecStart=/opt/home-network-api-server/.venv/bin/home-network-collector

# ルーターが応答しない場合に備えて上限を設ける (timer の間隔より短くする)
TimeoutStartSec=60

# 一時的な失敗は次の timer 発火に任せるので、ここでは再試行しない
StandardOutput=journal
StandardError=journal
SyslogIdentifier=home-network-collector

# --- 権限の絞り込み ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
