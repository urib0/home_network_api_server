[Unit]
Description=Archer A10 のクライアント一覧を取得して JSON に保存する (ワンショット)
Documentation=https://github.com/uribo/home_network_api_server
# ユーザーインスタンスには network-online.target が無いので順序付けはしない。
# 起動直後にネットワークが未接続でも、次の timer 発火 (5 分後) で回復する。

[Service]
Type=oneshot

# ルーターの IP / ユーザー名 / パスワードはこのファイルに置く (0600)
# %E はユーザーインスタンスでは ~/.config に解決される
EnvironmentFile=%E/home-network-api-server/router.env

# %S はユーザーインスタンスでは ~/.local/state。ディレクトリは systemd が作る
StateDirectory=home-network-api-server
Environment=CLIENTS_JSON_PATH=%S/home-network-api-server/clients.json

WorkingDirectory=%h/home-network-api-server
ExecStart=%h/home-network-api-server/.venv/bin/home-network-collector

# ルーターが応答しない場合に備えて上限を設ける (timer の間隔より短くする)
TimeoutStartSec=60

# 一時的な失敗は次の timer 発火に任せるので、ここでは再試行しない
StandardOutput=journal
StandardError=journal
SyslogIdentifier=home-network-collector

# --- 権限の絞り込み ---
# 一般ユーザー権限で動くため、mount namespace を使う指定 (ProtectSystem / ProtectHome /
# PrivateTmp など) は外してある。ユーザーインスタンスでは環境によって失敗し、
# 起動しなくなるリスクのわりに得られるものが小さい。
# 以下は seccomp / prctl ベースで、追加の準備なしに確実に効くものだけ。
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# timer から起動されるので [Install] は持たない。
# 手動実行は systemctl --user start home-network-collector.service
