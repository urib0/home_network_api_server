# ルーター接続情報（このファイルをコピーして .env を作る / 本番は ~/.config/home-network-api-server/router.env）
# RTX810 側で `sshd service on` と `login user <名前> <パスワード>` を設定しておくこと（README 参照）
ROUTER_HOST=192.168.100.1
ROUTER_SSH_PORT=22
ROUTER_USERNAME=
ROUTER_PASSWORD=
ROUTER_TIMEOUT=10

# Archer A10（任意）。接続種別（Wi-Fi / 有線）などを補うために使う。
ARCHER_HOST=http://10.10.10.5
ARCHER_USERNAME=admin
ARCHER_PASSWORD=
ARCHER_TIMEOUT=10

# API サーバーの待ち受け設定
API_HOST=0.0.0.0
API_PORT=8000
